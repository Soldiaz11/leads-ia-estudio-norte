{
  "id": "leads-ia-simple",
  "name": "Leads estudio de arquitectura",
  "nodes": [
    {
      "id": "d4286d5d-e059-4afa-9d44-a296ae0a6cbe",
      "name": "Gmail: Nuevo Email de Cliente",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "event": "messageReceived",
        "simple": false,
        "maxResults": 1,
        "filters": {
          "q": "subject:(consulta OR presupuesto OR cotizacion OR reforma) -from:me -subject:APROBACION",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": false
        }
      },
      "credentials": {}
    },
    {
      "id": "9e5f094c-7ed7-40fc-b269-3ce24e381df5",
      "name": "Preparar Datos y Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "nombre",
              "value": "={{ $json.from.value[0].name || $json.from.value[0].address.split('@')[0] }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "email",
              "value": "={{ $json.from.value[0].address.toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "asunto",
              "value": "={{ $json.subject }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "mensaje",
              "value": "={{ ($json.text || '').split(/\\n\\s*(El|On) .+(escribió|wrote):/)[0].replace(/[{}]/g, '').trim().slice(0, 2000) }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "gmailMessageId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "gmailThreadId",
              "value": "={{ $json.threadId }}",
              "type": "string"
            },
            {
              "id": "a7",
              "name": "empresa",
              "value": "Estudio Norte Arquitectura",
              "type": "string"
            },
            {
              "id": "a8",
              "name": "emailNegocio",
              "value": "solagudiaz@gmail.com",
              "type": "string"
            },
            {
              "id": "a9",
              "name": "emailAprobador",
              "value": "solagudiaz@gmail.com",
              "type": "string"
            },
            {
              "id": "a10",
              "name": "minCaracteres",
              "value": 15,
              "type": "number"
            }
          ]
        }
      }
    },
    {
      "id": "93be450c-1eaf-45cd-b78c-937bf49b95eb",
      "name": "Filtro Anti-Bucle",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "={{ $json.emailNegocio }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ $json.asunto }}",
              "rightValue": "APROBACION",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            },
            {
              "leftValue": "={{ $json.mensaje.length }}",
              "rightValue": "={{ $json.minCaracteres }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        }
      }
    },
    {
      "id": "c9e6b6a3-4e48-4758-b4cd-24d2033e57b4",
