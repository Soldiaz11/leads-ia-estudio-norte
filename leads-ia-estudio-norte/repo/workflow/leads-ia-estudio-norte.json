        "message": "=<h3>Nuevo posible cliente</h3><p><b>De:</b> {{ $('Preparar Datos y Configuración').first().json.nombre }} ({{ $('Preparar Datos y Configuración').first().json.email }})<br><b>Score:</b> {{ $('Extraer Respuesta de Claude').first().json.ia.score }}/100 - {{ $('Extraer Respuesta de Claude').first().json.ia.categoria }}<br><b>Resumen:</b> {{ $('Extraer Respuesta de Claude').first().json.ia.resumen }}</p><p><b>Mensaje original:</b><br><i>{{ $('Preparar Datos y Configuración').first().json.mensaje }}</i></p><hr><p><b>Respuesta que se va a enviar:</b></p><p>{{ $('Extraer Respuesta de Claude').first().json.ia.respuesta.replace(/\\n/g, '<br>') }}</p><p><a href=\"{{ $('Guardar Lead en Notion (Pendiente)').first().json.url }}\">Ver lead en Notion</a></p>",
